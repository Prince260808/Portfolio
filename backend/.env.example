# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GOOGLE_API_KEY=
# Qdrant is OPTIONAL. Leave both empty (or set VECTOR_STORE=memory) to use the built-in in-memory index.
QDRANT_URL=
QDRANT_API_KEY=
# VECTOR_STORE=memory
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Optional
PORT=5000
# Minimum similarity (0-1) for a chunk to be used; lower = more permissive
RETRIEVAL_MIN_SCORE=0.35
